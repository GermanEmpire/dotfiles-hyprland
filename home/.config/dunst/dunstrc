[global]
    monitor = 0
    follow = keyboard
    geometry = "500x10-8+34"
    indicate_hidden = yes
    shrink = true
    transparency = 6
    notification_height = 0
    separator_height = 0
    padding = 20
    horizontal_padding = 20
    frame_width = 1
    separator_color = auto
    font = Sarasa Term SC
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    max_icon_size = 64
    icon_theme = dracula-icons
    enable_recursive_icon_lookup = true
    sticky_history = yes
    history_length = 20
    always_run_script = true
    startup_notification = false
    browser = /usr/bin/firefox -new-tab
    verbosity = mesg
    corner_radius = 0
    force_xinerama = false
    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_background = "#1a1624"
    progress_bar_foreground = "#b2aad3"

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
background = "#000000"
foreground = "#b2aad3"
frame_color = "#332d49"
highlight = "#b2aad3"
timeout = 4

[urgency_normal]
background = "#000000"
foreground = "#b2aad3"
frame_color = "#332d49"
highlight = "#b2aad3"
timeout = 6

[urgency_critical]
background = "#000000"
foreground = "#b2aad3"
frame_color = "#332d49"
highlight = "#b2aad3"
timeout = 0
